---
import '@fontsource-variable/archivo';
import '@fontsource-variable/atkinson-hyperlegible-next';
import '../styles/global.css';
import { contenidos, idiomas } from '../contenido';
import type { Idioma } from '../contenido/tipos';

interface Props {
  idioma: Idioma;
  titulo: string;
  descripcion: string;
  /** false en páginas sin equivalente por idioma (404): sin canonical ni hreflang. */
  alternas?: boolean;
}
const { idioma, titulo, descripcion, alternas = true } = Astro.props;
const url = (ruta: string, sitio = Astro.site) => new URL(ruta, sitio).href;
const sitioSocial = import.meta.env.PUBLIC_URL_VISTA_PREVIA
  || (Astro.site?.hostname === 'example.com' ? 'https://preview.optimyzejersey.pages.dev' : Astro.site);
const imagenSocial = url(`/og/optimyze-${idioma}.jpg`, sitioSocial);
const altImagenSocial = `${titulo}. ${contenidos[idioma].meta.imagenSocialAlt}`;
---

<!doctype html>
<html lang={idiomas[idioma].html}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <meta name="theme-color" content="#07080c" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {
      alternas && (
        <>
          <link rel="canonical" href={url(idiomas[idioma].ruta)} />
          <link rel="alternate" hreflang="en" href={url(idiomas.en.ruta)} />
          <link rel="alternate" hreflang="es" href={url(idiomas.es.ruta)} />
          <link rel="alternate" hreflang="x-default" href={url(idiomas.en.ruta)} />
          <meta property="og:type" content="website" />
          <meta property="og:title" content={titulo} />
          <meta property="og:description" content={descripcion} />
          <meta property="og:url" content={url(idiomas[idioma].ruta, sitioSocial)} />
          <meta property="og:image" content={imagenSocial} />
          <meta property="og:image:type" content="image/jpeg" />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta property="og:image:alt" content={altImagenSocial} />
          <meta name="twitter:card" content="summary_large_image" />
          <meta name="twitter:title" content={titulo} />
          <meta name="twitter:description" content={descripcion} />
          <meta name="twitter:image" content={imagenSocial} />
          <meta name="twitter:image:alt" content={altImagenSocial} />
        </>
      )
    }
    <slot name="head" />
  </head>
  <body>
    <canvas id="viaje" aria-hidden="true"></canvas>
    <slot />
    <script>
      import '../viaje/arranque';
    </script>
  </body>
</html>
